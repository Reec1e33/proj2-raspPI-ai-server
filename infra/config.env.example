# PiCloud host configuration for bootstrap.sh and verify.sh.
#
#   cp config.env.example config.env && chmod 600 config.env && $EDITOR config.env
#
# This file is Bash: bootstrap.sh sources it as root. Use plain KEY=value lines.
# config.env is gitignored; it can hold secrets (DDNS_PASSWORD).
# Empty or unset values fall back to the defaults in lib/config.sh (config_defaults).

# --- Identity ----------------------------------------------------------------

# REQUIRED. The non-root login user (Raspberry Pi Imager asks for it).
# Only this user may log in over SSH; it also joins the docker group.
ADMIN_USER=""

# Optional public key to add to ADMIN_USER's ~/.ssh/authorized_keys before
# password login is turned off. Leave empty if you already ran ssh-copy-id.
SSH_AUTHORIZED_KEY=""

PI_HOSTNAME="picloud"
TIMEZONE="Etc/UTC"                 # e.g. Europe/London, America/New_York

# --- SSH and firewall --------------------------------------------------------

# Changing the port also opens it in UFW in the same run. The old port 22 rule
# stays until you delete it (verify a new session first).
SSH_PORT="22"

# Extra ports reachable ONLY from the LAN, space-separated "port/proto".
# Example: LAN_ALLOW_PORTS="9100/tcp 5353/udp"
# The module only adds rules. To close a port again, remove it here and run
# e.g.: sudo ufw delete allow from 192.168.1.0/24 to any port 9100 proto tcp
LAN_CIDR="192.168.1.0/24"
LAN_ALLOW_PORTS=""

# --- Automatic updates -------------------------------------------------------

# Reboot after updates that need it (kernel, firmware, libc), at this time.
AUTO_REBOOT="true"
AUTO_REBOOT_TIME="04:00"
# Optional: mail unattended-upgrade errors here (needs a working MTA such as msmtp-mta).
UPGRADE_MAIL=""
# Also install Docker Engine updates from download.docker.com. The upgrade
# restarts dockerd; live-restore (docker module) keeps the containers running.
UPGRADE_DOCKER="true"

# --- Network -----------------------------------------------------------------

# Static IPv4 via NetworkManager. Leave STATIC_IP_CIDR empty to keep DHCP.
# Pick an address outside the router's DHCP pool (or reserve it on the router).
NET_IFACE="eth0"
STATIC_IP_CIDR=""                  # e.g. 192.168.1.50/24
STATIC_GATEWAY=""                  # e.g. 192.168.1.1
STATIC_DNS="1.1.1.1 9.9.9.9"

# Dynamic DNS with ddclient: "noip", "cloudflare" or empty (off).
#   No-IP:      DDNS_LOGIN=<account or DDNS key user>, DDNS_PASSWORD=<password or DDNS key>
#   Cloudflare: DDNS_ZONE=example.com, DDNS_PASSWORD=<API token with Zone.DNS edit>
DDNS_PROVIDER=""
DDNS_HOSTNAME=""                   # e.g. myhome.ddns.net or pi.example.com
DDNS_LOGIN=""
DDNS_PASSWORD=""
DDNS_ZONE=""

# --- Logging -----------------------------------------------------------------

# log2ram keeps /var/log in RAM to reduce SD-card wear; logs written since the
# last sync are lost on a power cut. Not needed when the Pi boots from an SSD.
LOG2RAM_ENABLE="false"
LOG2RAM_SIZE="256M"                # must hold the journal (capped at 200M)

# --- PiCloud stack -----------------------------------------------------------

# Where the repository is cloned; picloud.service runs compose in $PICLOUD_DIR/deploy.
PICLOUD_DIR="/opt/picloud"
