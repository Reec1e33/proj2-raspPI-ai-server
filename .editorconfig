# https://editorconfig.org — matches gofmt, ruff, prettier and alloy fmt.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,go.sum}]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.alloy]
indent_style = tab

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,mjs,css,html}]
max_line_length = 100

[{*.conf,*.conf.template,Dockerfile,*.Dockerfile}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
