# PiCloud stack settings. Copy to deploy/.env and edit; .env is git-ignored.
# Docker Compose reads deploy/.env automatically. Commented lines show the
# defaults: uncomment a line only to change it. Do not leave a value empty
# unless the comment says that empty is valid.

# --- Gateway -----------------------------------------------------------------
# The DNS name of the Pi (one name). Grafana uses it for links,
# gen-self-signed-cert.sh puts it in the certificate and smoke-test.sh tests it.
# The gateway also answers on other names and on the IP address.
SERVER_NAME=picloud.local

# Tag of the ghcr.io/reec1e33/picloud-{gateway,api,agent} images: a release
# such as 2.0.0, or latest.
PICLOUD_VERSION=latest

# --- Optional services -------------------------------------------------------
# "ollama" runs a local LLM. Keep it on an 8 GB Pi. On a 4 GB Pi, remove it,
# uncomment PICLOUD_OLLAMA_URL= (empty) below and set a cloud provider key.
COMPOSE_PROFILES=ollama

# --- AI providers (api) ------------------------------------------------------
# Fallback chain. Providers without a key (or URL) are skipped.
# PICLOUD_PROVIDER_ORDER=ollama,anthropic,openai

# Ollama. An empty URL disables the provider.
# PICLOUD_OLLAMA_URL=http://ollama:11434
# PICLOUD_OLLAMA_MODEL=llama3.2:1b

# Anthropic. Unset disables the provider.
# ANTHROPIC_API_KEY=
# PICLOUD_ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI or any OpenAI-compatible API. An unset key disables the provider.
# For Groq: PICLOUD_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# PICLOUD_OPENAI_BASE_URL=https://api.openai.com/v1
# PICLOUD_OPENAI_MODEL=gpt-4o-mini

# --- api ---------------------------------------------------------------------
# When set, POST /api/chat requires the header X-API-Key with this value.
# PICLOUD_API_KEY=
# Chat requests per client IP. The gateway also allows 30/minute per IP.
# PICLOUD_CHAT_RATE_LIMIT=20/minute
# PICLOUD_MAX_TOKENS=1024
# PICLOUD_REQUEST_TIMEOUT_S=60
# Seconds between snapshots on /api/system/stream.
# PICLOUD_STREAM_INTERVAL_S=2
# Comma-separated origins. Not needed behind the gateway (same origin).
# PICLOUD_CORS_ORIGINS=
# debug, info, warning, error or critical. Logs are always JSON (for Loki).
# PICLOUD_LOG_LEVEL=info

# --- Agent -------------------------------------------------------------------
# Comma-separated mount points to report, e.g. /,/mnt/ssd
# PI_AGENT_MOUNTS=/
# PI_AGENT_INTERVAL=2s
# PI_AGENT_LOG_LEVEL=info
# Firmware mailbox device for the throttle state (under-voltage, throttling).
# /dev/vcio exists on every Raspberry Pi kernel. Use /dev/vcio_gencmd when
# `ls -l /dev/vcio*` shows it (kernels from 2026 on); there /dev/vcio is
# root-only. The agent container does not start if the device does not exist.
# Use /dev/null on a host that is not a Pi; the throttle metrics then stop.
# PI_AGENT_MAILBOX_DEVICE=/dev/vcio

# --- Grafana -----------------------------------------------------------------
# The admin account is needed only to edit; viewers browse anonymously behind
# the gateway's basic auth. Use a long random password: openssl rand -base64 24
# Grafana reads the password only at its first start (empty grafana-data
# volume). A later edit here has no effect; see README.md to change it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Retention ---------------------------------------------------------------
# Prometheus deletes data older than the time OR above the size.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
# Loki log retention (the compactor deletes older chunks).
LOKI_RETENTION_PERIOD=168h

# --- Memory limits -----------------------------------------------------------
# Defaults suit an 8 GB Pi. A 4 GB Pi runs without Ollama (remove it from
# COMPOSE_PROFILES) and uses the values in brackets. See README.md.
MEM_LIMIT_OLLAMA=4g
# [256m]
MEM_LIMIT_PROMETHEUS=512m
# [256m]
MEM_LIMIT_LOKI=384m
# [512m] Do not go lower: Grafana's Go runtime targets 400 MiB (GOMEMLIMIT
# in docker-compose.yml).
MEM_LIMIT_GRAFANA=512m

# --- Development only (docker-compose.dev.yml) -------------------------------
# Ollama URL for the dev stack, e.g. a native Ollama on the laptop:
# PICLOUD_DEV_OLLAMA_URL=http://host.docker.internal:11434
