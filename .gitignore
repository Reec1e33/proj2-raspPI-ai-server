# Repository-wide rules only. Each component's own .gitignore (agent/, api/,
# web/, deploy/, infra/) lists its build output and local secrets.

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace
.claude/

# Local environment files and keys
.env
.env.*
!.env.example
*.pem
*.key

# Caches and build output
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
node_modules/
*.tsbuildinfo
coverage/
coverage.out
*.log
# Release binaries built by .github/workflows/release.yml
/dist/
